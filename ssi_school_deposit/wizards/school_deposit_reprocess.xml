<odoo>
<record id="school_deposit_reprocess_view_form" model="ir.ui.view">
    <field name="name">school_deposit_reprocess - form</field>
    <field name="model">school_deposit_reprocess</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field name="type_ids" widget="many2many_tags" />
                <field name="partner_ids" widget="many2many_tags" />
            </group>
            <footer>
                <button
                        name="action_reprocess"
                        type="object"
                        string="Reprocess"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record id="school_deposit_reprocess_action" model="ir.actions.act_window">
    <field name="name">Reprocess Deposit Realizations</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_deposit_reprocess</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

</odoo>
