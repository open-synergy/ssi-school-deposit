<odoo>
<record id="school_deposit_type_view_tree" model="ir.ui.view">
    <field name="name">school_deposit_type - tree</field>
    <field name="model">school_deposit_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="deposit_account_id" />
                <field name="realization_journal_id" />
                <field name="auto_realize" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_deposit_type_view_form" model="ir.ui.view">
    <field name="name">school_deposit_type - form</field>
    <field name="model">school_deposit_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="deposit_account_id" />
                <field name="realization_journal_id" />
                <field name="auto_realize" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="product" string="Products">
                    <group name="product_1" colspan="4" col="2">
                        <field name="source_product_ids" widget="many2many_tags" />
                        <field name="target_product_ids" widget="many2many_tags" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_deposit_type_action" model="ir.actions.act_window">
    <field name="name">School Deposit Types</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_deposit_type</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_deposit_type_menu"
        name="School Deposit Types"
        parent="menu_school_deposit_configuration"
        action="school_deposit_type_action"
        groups="school_deposit_type_group"
        sequence="10"
    />

</odoo>
