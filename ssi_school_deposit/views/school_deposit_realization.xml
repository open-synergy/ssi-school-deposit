<odoo>
<record id="school_deposit_realization_view_search" model="ir.ui.view">
    <field name="name">school_deposit_realization - search</field>
    <field name="model">school_deposit_realization</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="type_id" />
                <field name="partner_id" />
                <field name="customer_invoice_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_type_id"
                            string="Type"
                            context="{'group_by': 'type_id'}"
                        />
                    <filter
                            name="group_by_partner_id"
                            string="Partner"
                            context="{'group_by': 'partner_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_deposit_realization_view_tree" model="ir.ui.view">
    <field name="name">school_deposit_realization - tree</field>
    <field name="model">school_deposit_realization</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="type_id" />
                <field name="partner_id" />
                <field name="customer_invoice_id" />
                <field name="amount_total" widget="monetary" />
                <field name="currency_id" invisible="1" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_deposit_realization_view_form" model="ir.ui.view">
    <field name="name">school_deposit_realization - form</field>
    <field name="model">school_deposit_realization</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="type_id" />
                <field name="deposit_account_id" invisible="1" />
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                        name="action_compute_line"
                        type="object"
                        string="Compute Lines"
                        class="oe_highlight"
                        states="draft"
                        groups="school_deposit_realization_user_group"
                    />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="partner_id" />
                <field name="customer_invoice_id" />
                <field name="currency_id" invisible="1" />
                <field name="company_currency_id" invisible="1" />
            </xpath>
            <xpath expr="//group[@name='footer_left']" position="inside">
                <field
                        name="amount_total"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="accounting" string="Accounting">
                    <group name="accounting_1" colspan="4" col="2">
                        <field name="journal_id" />
                        <field name="receivable_account_id" />
                        <field name="move_id" />
                        <field name="receivable_move_line_id" />
                    </group>
                </page>
                <page name="line" string="Lines">
                    <field name="line_ids" colspan="4" nolabel="1">
                        <tree editable="bottom">
                            <field
                                    name="source_move_line_id"
                                    domain="[('account_id', '=', parent.deposit_account_id), ('partner_id', '=', parent.partner_id), ('credit', '>', 0), ('amount_residual', '&lt;', 0), ('move_id.state', '=', 'posted')]"
                                />
                            <field name="account_id" />
                            <field name="amount" widget="monetary" />
                            <field name="move_line_id" />
                            <field name="currency_id" invisible="1" />
                        </tree>
                        <form>
                            <group col="2">
                                <field
                                        name="source_move_line_id"
                                        domain="[('account_id', '=', parent.deposit_account_id), ('partner_id', '=', parent.partner_id), ('credit', '>', 0), ('amount_residual', '&lt;', 0), ('move_id.state', '=', 'posted')]"
                                    />
                                <field name="account_id" />
                                <field name="amount" widget="monetary" />
                                <field name="move_line_id" />
                                <field name="currency_id" invisible="1" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_deposit_realization_action" model="ir.actions.act_window">
    <field name="name">School Deposit Realizations</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_deposit_realization</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_deposit_realization_menu"
        name="Deposit Realizations"
        parent="menu_school_deposit"
        action="school_deposit_realization_action"
        groups="school_deposit_realization_viewer_group"
        sequence="10"
    />
<menuitem
        id="school_deposit_reprocess_menu"
        name="Reprocess Deposit Realizations"
        parent="menu_school_deposit"
        action="school_deposit_reprocess_action"
        groups="school_deposit_realization_validator_group"
        sequence="20"
    />
</odoo>
