<odoo>

<record id="school_deposit_realization_view_tree_ou" model="ir.ui.view">
    <field name="name">school_deposit_realization tree - operating unit</field>
    <field name="model">school_deposit_realization</field>
    <field
            name="inherit_id"
            ref="ssi_school_deposit.school_deposit_realization_view_tree"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="school_deposit_realization_view_form_ou" model="ir.ui.view">
    <field name="name">school_deposit_realization form - operating unit</field>
    <field name="model">school_deposit_realization</field>
    <field
            name="inherit_id"
            ref="ssi_school_deposit.school_deposit_realization_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
            <xpath expr="//field[@name='receivable_move_line_id']" position="after">
                <field
                        name="interunit_move_ids"
                        widget="many2many_tags"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

</odoo>
